DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/emma

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_API_KEY=

STT_BACKEND=whisper
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LOAD_TIMEOUT=120

TTS_BACKEND=piper
PIPER_MODEL=en_US-lessac-medium
PIPER_MODELS_DIR=models
PIPER_SPEECH_SPEED=1.0

EMBEDDING_MODEL=bge-m3
RAG_TOP_K=3
RAG_MIN_SCORE=0.0
RAG_ENABLED=true

EMMA_NAME=Emma
EMMA_VOICE_LOCALE=en-US
EMMA_VARIANT=American English

MAX_SPEAK_CHARS=220
HISTORY_TURNS=12
MAX_CORRECTIONS=3

API_HOST=127.0.0.1
API_PORT=8000

# Only used when STT_BACKEND=fake: a fixed transcript, useful for demos and manual testing.
FAKE_TRANSCRIPT=
VITE_API_BASE=